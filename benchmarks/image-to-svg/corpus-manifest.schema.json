{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cylinderseal.studio/schemas/image-to-svg/corpus-manifest.schema.json",
  "title": "Image-to-SVG benchmark corpus manifest",
  "description": "A frozen, rights-audited inventory of raster inputs and SVG references.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "corpus", "split_policy", "cases"],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "corpus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "title", "description", "created_at", "case_count"],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "version": {
          "$ref": "#/$defs/semanticVersion"
        },
        "title": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "description": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "case_count": {
          "type": "integer",
          "minimum": 3
        }
      }
    },
    "split_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "frozen_at", "test_is_sealed", "counts"],
      "properties": {
        "strategy": {
          "const": "frozen"
        },
        "frozen_at": {
          "type": "string",
          "format": "date-time"
        },
        "test_is_sealed": {
          "const": true
        },
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["development", "validation", "test"],
          "properties": {
            "development": {
              "type": "integer",
              "minimum": 1
            },
            "validation": {
              "type": "integer",
              "minimum": 1
            },
            "test": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 3,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "maxLength": 128
    },
    "semanticVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "unit"],
      "properties": {
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "unit": {
          "enum": ["px", "viewBox"]
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "dependentRequired": {
        "profile": ["profile_version"],
        "profile_version": ["profile"]
      },
      "required": ["path", "sha256", "media_type", "dimensions"],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "media_type": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "dimensions": {
          "$ref": "#/$defs/dimensions"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "profile": {
          "$ref": "#/$defs/identifier"
        },
        "profile_version": {
          "$ref": "#/$defs/semanticVersion"
        }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "media_type", "dimensions", "kind"],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "media_type": {
          "const": "image/svg+xml"
        },
        "dimensions": {
          "$ref": "#/$defs/dimensions"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "kind": {
          "$ref": "#/$defs/identifier"
        },
        "render": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256", "media_type", "dimensions"],
          "properties": {
            "path": {
              "$ref": "#/$defs/relativePath"
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            },
            "media_type": {
              "const": "image/png"
            },
            "dimensions": {
              "$ref": "#/$defs/dimensions"
            },
            "bytes": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "title",
        "creator",
        "group_id",
        "page_url",
        "direct_url",
        "accessed_at",
        "sha256",
        "transformation"
      ],
      "properties": {
        "kind": {
          "enum": [
            "external",
            "open_license",
            "public_domain",
            "project_original",
            "procedural",
            "model_assisted_existing_gold"
          ]
        },
        "title": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "creator": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "group_id": {
          "$ref": "#/$defs/identifier"
        },
        "page_url": {
          "type": ["string", "null"],
          "format": "uri"
        },
        "direct_url": {
          "type": ["string", "null"],
          "format": "uri"
        },
        "accessed_at": {
          "type": "string",
          "format": "date"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "transformation": {
          "type": ["string", "null"]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "enum": ["external", "open_license", "public_domain"]
              }
            }
          },
          "then": {
            "anyOf": [
              {
                "properties": {
                  "page_url": {
                    "type": "string"
                  }
                }
              },
              {
                "properties": {
                  "direct_url": {
                    "type": "string"
                  }
                }
              }
            ]
          }
        }
      ]
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "license_spdx",
        "license_url",
        "attribution",
        "license_evidence_url",
        "redistribution_allowed",
        "adaptation_allowed",
        "training_allowed",
        "notes"
      ],
      "properties": {
        "license_spdx": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "license_url": {
          "type": "string",
          "format": "uri"
        },
        "attribution": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "license_evidence_url": {
          "type": "string",
          "format": "uri"
        },
        "redistribution_allowed": {
          "type": "boolean"
        },
        "adaptation_allowed": {
          "type": "boolean"
        },
        "training_allowed": {
          "type": "boolean"
        },
        "notes": {
          "type": "string"
        }
      },
      "if": {
        "properties": {
          "training_allowed": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "adaptation_allowed": {
            "const": true
          }
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "split",
        "split_frozen",
        "categories",
        "tags",
        "difficulty",
        "input",
        "reference",
        "source",
        "rights"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "title": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "split": {
          "enum": ["development", "validation", "test"]
        },
        "split_frozen": {
          "const": true
        },
        "categories": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "difficulty": {
          "enum": ["easy", "medium", "hard"]
        },
        "input": {
          "$ref": "#/$defs/artifact"
        },
        "reference": {
          "$ref": "#/$defs/reference"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "rights": {
          "$ref": "#/$defs/rights"
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
